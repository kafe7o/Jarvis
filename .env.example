# Копирай като .env и попълни това, което ти трябва. Празните услуги просто се изключват.

# --- Мозък (задължително) — https://console.anthropic.com
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5-5
JARVIS_EFFORT=xhigh             # колко дълбоко мисли: low | medium | high | xhigh | max
JARVIS_USER_NAME=сър
JARVIS_LANGUAGE=bg

# --- Компютър и файлове
# Папки, до които Jarvis има достъп (разделени с ':' на Linux/macOS, ';' на Windows).
# Празно = домашната папка. Пълен достъп до диска: / (Linux/macOS) или C:\ (Windows)
JARVIS_FILE_ROOTS=
# 1 = команди и промени по файловете без питане (обажданията и плащанията ВИНАГИ питат)
JARVIS_TRUST_LOCAL=0
JARVIS_HEARTBEAT_MINUTES=60     # колко често сам преглежда задачи/календар/поща (0 = изключено)
JARVIS_QUIET_HOURS=23-7         # часове, в които не те безпокои
JARVIS_MAX_TOOL_ROUNDS=80       # колко стъпки може да направи за една задача
JARVIS_BROWSER_HEADLESS=0       # 1 = браузърът работи невидимо

# --- Обаждания и SMS — https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=            # номерът, от който звъни Jarvis, напр. +1...
JARVIS_OWNER_PHONE=             # твоят телефон, напр. +359888123456
TWILIO_VOICE=Google.bg-BG-Standard-A
# Двупосочни разговори и вдигане на входящи: публичен https адрес към JARVIS_PHONE_PORT (напр. ngrok)
JARVIS_PUBLIC_URL=
JARVIS_PHONE_PORT=8765

# --- Плащания — https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=
JARVIS_CURRENCY=eur

# --- Имейл (за Gmail: App Password, smtp.gmail.com / imap.gmail.com)
JARVIS_SMTP_HOST=
JARVIS_SMTP_PORT=587
JARVIS_IMAP_HOST=
JARVIS_EMAIL_USER=
JARVIS_EMAIL_PASSWORD=

# --- Telegram бот (говори с Jarvis от телефона) — @BotFather; своя id виж от @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# --- Глас
JARVIS_WHISPER_MODEL=small      # tiny | base | small | medium | large-v3
JARVIS_TTS_VOICE=bg-BG-BorislavNeural

# --- Всички устройства
JARVIS_WEB_TOKEN=               # дълъг случаен низ; нужен и на jarvis node
JARVIS_WEB_PORT=8770
JARVIS_HUB_URL=                 # само на другите компютри: http://<главния>:8770
# Android телефон и TV през adb
JARVIS_ADB_DEVICES=             # напр. phone=192.168.1.20:5555,tv=192.168.1.30:5555

# --- Умен дом (Home Assistant)
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# --- Google Calendar и Gmail (после: jarvis google-login)
GOOGLE_CLIENT_SECRET=

# --- Плащания към други хора
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
WISE_API_TOKEN=

# --- WhatsApp през API (без него се ползва WhatsApp Web в браузъра на Jarvis)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# --- Известия на телефона (приложение ntfy, iPhone и Android)
NTFY_TOPIC=

# --- Глас на Jarvis по телефона (1 = неврален глас, 0 = гласът на Twilio)
JARVIS_PHONE_NEURAL=1
